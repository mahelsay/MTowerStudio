# MTower Studio — local settings. Git-ignored: never commit, never paste contents into chat.
# IDs are not secret; the client secret is. Rotate the secret per runbook if shared in plaintext.

# Azure — MTower Studio landing zone (East US 2, naming token: mtowerstudio)
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REGION=
AZURE_RESOURCE_GROUP=

# Written after deploy:
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_STORAGE_BLOB_ENDPOINT=

# Generation providers (copied from MTower 2026-10-18)
FAL_KEY=

# Engine spending limits (USD). The studio ledger (engine/ledger.jsonl) starts fresh 2026-10-18; MTower history is engine/ledger.mtower-history.jsonl
MTOWER_BATCH_LIMIT_USD=
MTOWER_AZURE_MONTHLY_LIMIT_USD=
MTOWER_MONTHLY_LIMIT_USD=
MTOWER_MEDIA_ROOT=
ELEVENLABS_API_KEY=
